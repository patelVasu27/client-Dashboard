{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "@typescript-eslint",
    "react"
  ],
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "curly": ["error", "all"],
    "no-console": ["warn", { "allow": ["warn", "error", "info", "groupCollapsed"] }],
    "no-unused-vars": ["error", { "args": "after-used", "ignoreRestArgs": false }],
    "no-var": ["error"],
    "prefer-const": ["error"],
    "eqeqeq": ["error", "smart"],
    "no-throw-literal": ["error"],
    "no-null": ["error"],
    "no-eval": ["error"],
    "no-implied-eval": ["error"],
    "no-await-in-loop": ["warn"],
    "max-len": ["warn", { "code": 120, "ignoreUrls": true, "ignoreComments": true }],
    "object-shorthand": ["error", "always"],
    "prefer-arrow-callback": ["error"],
    "prefer-template": ["error"],
    "yoda": ["error", "never"],
    "key-spacing": ["error", { "beforeColon": false, "afterColon": true }],
    "comma-dangle": ["error", "always-multiline"],
    "comma-spacing": ["error", { "before": false, "after": true }],
    "space-before-blocks": ["error", "always"],
    "space-unary-ops": ["error", { "words": true, "nonwords": false }],
    "keyword-spacing": ["error"],
    "func-call-spacing": ["error"],
    "arrow-body-style": ["error", "as-needed"],
    "prefer-destructuring": ["error", { "object": true, "array": false }],
    "no-implicit-coercion": ["error"],
    "no-shadow": ["error"],
    "no-undef": ["error"],
    "no-empty": ["error"],
    "no-useless-catch": ["error"],
    "no-useless-return": ["error"],
    "no-else-return": ["error"],
    "no-lonely-if": ["error"],
    "no-multiple-empty-lines": ["error", { "max": 2 }],
    "operator-linebreak": ["error", "after"],
    "wrap-iife": ["error", "inside"],
    "for-direction": ["error"],
    "no-console": ["warn", { "allow": ["warn", "error", "info", "groupCollapsed"] }],
    "no-iterator": ["error"],
    "no-magic-numbers": ["off"],
    "no-redeclare": ["error"],
    "no-require-imports": ["off"],
    "no-sync-functions-in-loop": ["error"],
    "no-template-literals": ["off"],
    "prefer-promise-reject-errors": ["error"],
    "radix": ["error", "as-needed"],
    "valid-typeof": ["error"],
    "require-await": ["error"],
    "no-return-await": ["off"],
    "no-setter-return": ["error"],
    "no-import-assign": ["error"],
    "no-export-assign": ["error"],
    "prefer-arrow-callback": ["error"],
    "prefer-destructuring": ["error"],
    "prefer-exponentiation-operator": ["error"],
    "prefer-named-capture-group": ["off"],
    "prefer-numeric-literals": ["error"],
    "prefer-optional-catch-binding": ["error"],
    "prefer-promise-reject-errors": ["error"],
    "prefer-regex-literals": ["error"],
    "prefer-spread": ["error"],
    "prefer-template": ["error"],
    "prefer-nullish-coalescing": ["error"],
    "prefer-optional-chaining": ["error"],
    "prefer-arrow-callback": ["error"],
    "prefer-destructuring": ["error"],
    "prefer-nullish-coalescing": ["error"],
    "prefer-optional-chaining": ["error"],
    "prefer-regex-literals": ["error"],
    "prefer-spread": ["error"],
    "prefer-template": ["error"],
    "prefer-nullish-coalescing": ["error"],
    "prefer-optional-chaining": ["error"],
    "prefer-template": ["error"],
    "prefer-nullish-coalescing": ["error"],
    "prefer-optional-chaining": ["error"],
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
