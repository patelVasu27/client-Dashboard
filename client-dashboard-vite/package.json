    "@supabase/supabase-js": "^2.107.0"
  },
  "engines": {
    "node": "v18 || >=20",
    "npm": "9.0.0 || >=10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "chrome 88",
      "firefox 84",
      "safari 13"
    ]
  }
}