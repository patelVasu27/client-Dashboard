{
  "name": "client-dashboard-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:vercel": "npx vite build --mode production && echo 'Build optimized for Vercel deployment'",
