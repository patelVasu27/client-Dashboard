{
  "name": "client-dashboard-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:vercel": "vite build --mode production",
    "deploy:prepare": "npm run build:vercel && npx vercel deploy --prod --no-clipboard",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint ./src --ext .js,.jsx,.ts,.tsx --fix",
    "security-scan": "npm audit && npm ls && npm outdated"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0"
  },
  "engines": {
    "node": "v18 || >=20",
    "npm": "9.0.0 || >=10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "chrome 88",
      "firefox 84",
      "safari 13"
    ]
  }
}
