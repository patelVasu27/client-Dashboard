{
  "private": true,
  "workspaces": [
    "client-dashboard-vite"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client-dashboard-vite",
    "build": "npm run build --workspace=client-dashboard-vite",
    "build:vercel": "npm run build:vercel --workspace=client-dashboard-vite",
    "preview": "npm run preview --workspace=client-dashboard-vite",
    "deploy": "npm run deploy:prepare --workspace=client-dashboard-vite",
    "deploy:prod": "npm run build:vercel --workspace=client-dashboard-vite && npx vercel --prod",
    "lint": "npm run lint --workspace=client-dashboard-vite",
    "typecheck": "npm run typecheck --workspace=client-dashboard-vite",
    "clean": "npm run clean --workspace=client-dashboard-vite",
    "perf:check": "npx lhci autorun"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
